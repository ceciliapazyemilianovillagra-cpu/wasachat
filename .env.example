# ── BASE DE DATOS (Neon) ─────────────────────────────────────────────────────
# Conseguila en console.neon.tech → tu proyecto → Connection string
# Usá el pooled connection string (puerto 5432, ?sslmode=require al final)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/wasachat?sslmode=require

# ── ADMIN ────────────────────────────────────────────────────────────────────
# Cualquier string largo y secreto — protege todos los endpoints /api/agenda admin
AGENDA_ADMIN_SECRET=cambia-esto-por-algo-muy-largo-y-secreto

# ── WAHA (WhatsApp HTTP API) ─────────────────────────────────────────────────
# URL pública de tu servidor WAHA (en local: http://localhost:3000)
WAHA_URL=http://localhost:3000
# API key de WAHA si la configuraste (puede quedar vacío)
WAHA_API_KEY=
# Nombre de la sesión en WAHA (por defecto "default")
WAHA_SESSION=default
